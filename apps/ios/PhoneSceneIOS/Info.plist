	<string>PhoneScene cihaz yönünü 3DoF yedek takip için kullanır.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PhoneScene Windows Companion ile yerel ağda eşleşmek için kullanılır.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_phonescene._tcp</string>
	</array>
